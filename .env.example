# Copy to .env for local development (netlify dev). Never commit real values.
# In production these live ONLY in Netlify > Site configuration > Environment variables.

# Airtable (token scoped to the Guest Photo Drop base: data.records:read, data.records:write)
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_EVENTS_TABLE_ID=
AIRTABLE_UPLOADS_TABLE_ID=
AIRTABLE_CUSTOMERS_TABLE_ID=
AIRTABLE_ORDERS_TABLE_ID=

# Cloudinary (API secret stays server-side)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (use test keys sk_test_... until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Long random string for dashboard sessions
SESSION_SECRET=

# Public address of the site, used for Stripe return links (no trailing slash)
SITE_URL=

# Optional (defaults shown)
# MAX_IMAGE_MB=10
# MAX_VIDEO_MB=100
# EVENT_TIMEZONE=America/Chicago
# VITE_UPLOAD_CONCURRENCY=3
